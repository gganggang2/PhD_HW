data = group_stats,
aes(xintercept = mean_inf),
color = "red",
linetype = "dashed",
linewidth = 1.2
) +
# Median line
geom_vline(
data = group_stats,
aes(xintercept = median_inf),
color = "blue",
linetype = "solid",
linewidth = 1.2
) +
# Mean label
geom_text(
data = group_stats,
aes(
x = mean_inf,
y = Inf,
label = paste0("Mean = ", round(mean_inf, 2))
),
color = "red",
fontface = "bold",
vjust = 1.5,
hjust = -0.1
) +
# Median label
geom_text(
data = group_stats,
aes(
x = median_inf,
y = Inf,
label = paste0("Median = ", round(median_inf, 2))
),
color = "blue",
fontface = "bold",
vjust = 3.0,
hjust = -0.1
) +
facet_wrap(~ELS) +
labs(
x = "Inflammation",
y = "Density"
) +
theme_bw()
