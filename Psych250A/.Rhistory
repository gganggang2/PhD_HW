library(ggplot2)
library(psych)
library(summarytools)
filepath <- "https://raw.githubusercontent.com/craigenders/psych250a/main/data/assignment2.csv"
assign2 <- read.csv(filepath, stringsAsFactors = TRUE)
dfSummary(assign2)
describe(assign2$Attention)
stdev <- sd(assign2$Attention)/sqrt(length(assign2$Attention))
library(ggplot2)
library(Rmisc)
library(summarytools)
library(psych)
filepath <- "https://raw.githubusercontent.com/craigenders/psych250a/main/data/assignment4.csv"
assign4 <- read.csv(filepath, stringsAsFactors = TRUE)
dfSummary(assign4)
describe(assign4)
rm(assign2)
rm(stdev)
assign4$Female <- factor(assign4$Female,
levels = c(0, 1),
labels = c("Male", "Female"))
freq(assign4$Female)
print(freq(assign4$Female), method = "render")
freq(assign4)
freq(assign4$Female)
CI(assign4$Discrim, ci = 0.95)
group.CI(Discrim ~ Female, data = assign4, ci = 0.95)
ggplot(assign4, aes(x = Female, y = Discrim)) +
stat_summary(fun.data = mean_cl_normal, geom = "pointrange")
CI(assign4$Discrim, ci = 0.95)
library(ggplot2)
library(Rmisc)
library(summarytools)
library(psych)
filepath <- "https://raw.githubusercontent.com/craigenders/psych250a/main/data/assignment4.csv"
assign4 <- read.csv(filepath, stringsAsFactors = TRUE)
dfSummary(assign4)
describe(assign4)
assign4$Female <- factor(assign4$Female,
levels = c(0, 1),
labels = c("Male", "Female"))
freq(assign4$Female)
CI(assign4$Discrim, ci = 0.95)
group.CI(Discrim ~ Female, data = assign4, ci = 0.95)
ggplot(assign4, aes(x = Female, y = Discrim)) +
stat_summary(fun.data = mean_cl_normal, geom = "pointrange")
