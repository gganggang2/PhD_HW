# Calculate group statistics
group_stats <- assign1 %>%
group_by(ELS) %>%
summarize(
mean_inf = mean(Inflammation, na.rm = TRUE),
median_inf = median(Inflammation, na.rm = TRUE),
n = sum(!is.na(Inflammation))
)
ggplot(assign1, aes(x = Inflammation)) +
geom_histogram(
aes(y = after_stat(density)),
bins = 20,
fill = "skyblue",
color = "white"
) +
geom_density(linewidth = 1) +
# Mean line
geom_vline(
data = group_stats,
aes(xintercept = mean_inf),
color = "red",
linetype = "dashed",
linewidth = 1.2
) +
# Median line
geom_vline(
data = group_stats,
aes(xintercept = median_inf),
color = "blue",
linetype = "solid",
linewidth = 1.2
) +
# Mean label
geom_text(
data = group_stats,
aes(
x = mean_inf,
y = Inf,
label = paste0("Mean = ", round(mean_inf, 2))
),
color = "red",
fontface = "bold",
vjust = 1.5,
hjust = -0.1
) +
# Median label
geom_text(
data = group_stats,
aes(
x = median_inf,
y = Inf,
label = paste0("Median = ", round(median_inf, 2))
),
color = "blue",
fontface = "bold",
vjust = 3.0,
hjust = -0.1
) +
facet_wrap(~ELS) +
labs(
x = "Inflammation",
y = "Density"
) +
theme_bw()
ggplot(assign1, aes(x = Inflammation)) +
geom_histogram(
aes(y = after_stat(density)),
bins = 20,
fill = "skyblue",
color = "white"
) +
geom_density(linewidth = 1) +
# Mean line
geom_vline(
data = group_stats,
aes(xintercept = mean_inf),
color = "red",
linetype = "dashed",
linewidth = 1.2
) +
# Median line
geom_vline(
data = group_stats,
aes(xintercept = median_inf),
color = "blue",
linetype = "solid",
linewidth = 1.2
) +
geom_text(
data = group_stats,
aes(
x = Inf,
y = Inf,
label = paste(
"Mean =", round(mean_inf, 2),
"\nMedian =", round(median_inf, 2),
"\nN =", n
)
),
hjust = 1.05,
vjust = 1.1,
size = 4
) +
facet_wrap(~ELS) +
labs(
x = "Inflammation",
y = "Density"
) +
theme_bw()
