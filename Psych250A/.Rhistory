geom_histogram(aes(y = after_stat(density)),
bins = 20,
fill = "skyblue",
color = "white") +
geom_density(linewidth = 1) +
geom_vline(data = group_means,
aes(xintercept = mean_inf),
color = "red",
linewidth = 1.2,
linetype = "dashed") +
facet_wrap(~ELS) +
theme_bw()
