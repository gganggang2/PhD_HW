covariate_names <- paste0("x", 1:4)
lgm_data <- kypd[, c("t1", "t2", "t3", "t4", "t5", covariate_names)]
lgm_data <- as.data.frame(lgm_data)
control_settings <- semtree.control(
method = "fair",
min.bucket = 10,
alpha = 0.05
)
kypd_tree <- semtree(
model = fit_lgm,
data = lgm_data,
control = control_settings,
predictors = covariate_names
)
control_settings <- semtree.control(
method = "fair",
max.depth = 2,
min.N = 10,
alpha = 0.05,
exclude.heywood = T
)
kypd_tree <- semtree(
model = fit_lgm,
data = lgm_data,
control = control_settings,
predictors = covariate_names
)
control_settings <- semtree.control(
method = "naive",
max.depth = 2,
min.N = 10,
alpha = 0.05,
exclude.heywood = T
)
