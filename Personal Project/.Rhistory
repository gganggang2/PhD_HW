data = lgm_data,
control = control_settings,
predictors = covariate_names
)
plot(kypd_tree)
summary(kypd_tree)
script = mplusObject(
TITLE = 'KYPA LGM;',
MODEL = 'i s q| t1@0 t2@1 t3@2 t4@3 t5@4;',
usevariables = c('t1','t2','t3','t4','t5'),
rdata = kypd)
fit.mplustree = MplusTrees(script, kypd, group=~STID, rPartFormula =~ x1 + x2 + x3 + x4, control=rpart.control(cp=.001, minbucket=20))
?MplusTrees
fit.mplustree = MplusTrees(script, kypd,
group=~STID,
rPartFormula =~ x1 + x2 + x3,
control=rpart.control(cp=.001, minbucket=20))
fit.mplustree
plot(fit.mplustree)
?rpart.control
fit.mplustree = MplusTrees(script, kypd,
group=~STID,
rPartFormula =~ x1 + x2 + x3,
control=rpart.control(cp=.001,
minbucket=20,
maxdepth=3))
fit.mplustree
plot(fit.mplustree)
View(kypd)
summary(fit.mplustree)
