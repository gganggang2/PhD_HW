model = fit_lgm,
data = lgm_data,
control = control_settings,
predictors = covariate_names
)
plot(kypd_tree)
summary(kypd_tree)
control_settings <- semtree.control(
method = "fair",
min.bucket = 10,
alpha = 0.05
)
kypd_tree <- semtree(
model = fit_lgm,
data = lgm_data,
control = control_settings,
predictors = covariate_names
)
plot(kypd_tree)
View(lgm_data)
